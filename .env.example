# Database
DATABASE_URL="postgresql://postgres:yourpassword@postgres:5432/yourdbname"
DATABASE_NAME=yourdbname
DATABASE_USER=postgres
DATABASE_PWD=yourpassword

# JWT Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key
JWT_EMAIL_SECRET_KEY=your_jwt_email_secret_key

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_MINUTES=60

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SendGrid (get from https://app.sendgrid.com)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=your_email@example.com
